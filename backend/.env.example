# Copy to .env and fill in. Never commit .env.

# PostgreSQL connection string
DATABASE_URL=postgresql+psycopg2://smartqueue:smartqueue@localhost:5432/smartqueue

# Sign JWTs with this. Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Browser origin(s) allowed to call the API. Comma-separated.
FRONTEND_URL=http://localhost:3000

# development | production  (development auto-creates tables)
ENVIRONMENT=development

# Only used by seed.py
DEMO_ADMIN_PASSWORD=admin12345
DEMO_CUSTOMER_PASSWORD=customer12345
